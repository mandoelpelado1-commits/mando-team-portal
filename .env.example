# Copy this file to .env.local and fill in real values. Never commit .env.local.

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000

# App base URL used to build OAuth redirect/callback URLs
APP_BASE_URL=http://localhost:3000

# Secret that Vercel Cron sends as a Bearer token when it calls /api/cron/publish.
# Vercel sets this automatically when using Vercel Cron; set it yourself for other schedulers.
CRON_SECRET=

# Anthropic (AI post generator, step 5)
ANTHROPIC_API_KEY=

# Note: Instagram/Facebook/TikTok/YouTube/X credentials are NOT set here.
# Each team member registers their own developer app per platform and enters
# their client ID/secret directly in the portal (Dashboard > My Socials).
# Those are stored encrypted, per user, in the database - never shared.

# Google Ads API (step 4) - the one deliberately SHARED resource, one account
# for the whole team. Admin sets these once; do not scope per-user.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Wix Analytics Data API - also a shared resource (one company website).
# Generate the API key at https://manage.wix.com/account/api-keys with
# "Site Analytics - read" permission (SCOPE.DC-ANALYTICS-AND-REPORTS.READ-SITE-ANALYTICS).
WIX_API_KEY=
WIX_SITE_ID=

# Spotify Web API - public artist data (followers/popularity).
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Printify pop-up shop - merch sales.
# Personal Access Token from https://printify.com/app/account/api
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
