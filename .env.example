# Copy this file to .env.local and fill in real values. Never commit .env.local.

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000

# App base URL used to build OAuth redirect/callback URLs
APP_BASE_URL=http://localhost:3000

# Secret that Vercel Cron sends as a Bearer token when it calls /api/cron/publish.
# Vercel sets this automatically when using Vercel Cron; set it yourself for other schedulers.
CRON_SECRET=

# Anthropic (AI post generator, step 5)
ANTHROPIC_API_KEY=

# Anthropic Admin API key — separate from ANTHROPIC_API_KEY above, and more
# privileged (org-wide billing read access, not chat completions). Powers the
# "Anthropic billing" panel on the DITO page. Create one at
# https://console.anthropic.com under Settings > Admin API keys, with the
# Usage & Cost read scope. Starts with sk-ant-admin01-.
ANTHROPIC_ADMIN_API_KEY=

# Note: Instagram/Facebook/TikTok/YouTube/X credentials are NOT set here.
# Each team member registers their own developer app per platform and enters
# their client ID/secret directly in the portal (Dashboard > My Socials).
# Those are stored encrypted, per user, in the database - never shared.

# Google Ads API (step 4) - the one deliberately SHARED resource, one account
# for the whole team. Admin sets these once; do not scope per-user.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Wix Analytics Data API - also a shared resource (one company website).
# Generate the API key at https://manage.wix.com/account/api-keys with
# "Site Analytics - read" permission (SCOPE.DC-ANALYTICS-AND-REPORTS.READ-SITE-ANALYTICS).
WIX_API_KEY=
WIX_SITE_ID=

# Spotify Web API - public artist data (followers/popularity).
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Printify pop-up shop - merch sales.
# Personal Access Token from https://printify.com/app/account/api
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Resend - email notifications (budget approvals, new ideas).
# https://resend.com - free tier is plenty for a 3-person team.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Places API - venue autocomplete on the Shows & Booking page.
# Enable "Places API" at https://console.cloud.google.com, create an API key,
# and restrict it to Places API for security. Has a free monthly usage tier.
GOOGLE_PLACES_API_KEY=

# Microsoft Graph - lets each team member connect their own Outlook mailbox
# to import contacts (Dashboard > Contacts). Works for ANY Microsoft 365
# mailbox, including ones purchased/hosted through GoDaddy - GoDaddy "Outlook"
# accounts are real Microsoft 365 accounts, so auth still goes through
# Microsoft's login screen. ONE shared app registration covers the whole
# team; each person consents individually and only their own contacts sync.
# Register at https://portal.azure.com > App registrations > New registration
# (supported account types: any org directory + personal Microsoft accounts),
# add redirect URI {APP_BASE_URL}/api/contacts/outlook/callback (Web platform),
# then add the "Contacts.Read" and "User.Read" delegated Microsoft Graph
# permissions, and create a client secret under Certificates & secrets.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Calendar - lets each team member connect their own Google Calendar
# so posts placed on the Weekly Schedule also show up there. ONE shared app
# registration covers the whole team, same consent model as Microsoft above.
# Enable "Google Calendar API" at https://console.cloud.google.com, create an
# OAuth client (Web application), add redirect URI
# {APP_BASE_URL}/api/calendar/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Web push - phone/browser notifications for new ideas, pending budget
# approvals, and the daily "what needs attention" digest. Generate a keypair
# with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
